<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#4f46e5" />
    <base href="/" />
    <link rel="stylesheet" href="app.css" />
    <HeadOutlet @rendermode="NoPrerender" />
</head>
<body>
    <Routes @rendermode="NoPrerender" />
    <div id="blazor-error-ui">
        An error occurred. <a href="" class="reload">Reload</a>
    </div>
    <script src="_framework/blazor.web.js"></script>
</body>
</html>

@code {
    // No prerender so browser storage (login session) is available from the first render
    private static readonly IComponentRenderMode NoPrerender = new InteractiveServerRenderMode(prerender: false);
}
